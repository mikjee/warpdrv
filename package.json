{
	"name": "warpcore",
	"private": true,
	"version": "0.6.21",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -n server,app -c blue,green \"npm run dev -w @warpcore/server\" \"npm run dev -w @warpcore/app\"",
		"dev:server": "npm run dev -w @warpcore/server",
		"dev:app": "npm run dev -w @warpcore/app",
		"dev:desktop": "concurrently -n app,tauri -c green,blue \"cd packages/app && npm run dev -- --port 3000\" \"cd packages/desktop && npx @tauri-apps/cli dev\"",
		"build": "npm run build -w @warpcore/app",
		"build:desktop": "npm run build -w @warpcore/desktop",
		"release": "bash release.sh",
		"postinstall": "patch-package",
		"fmt": "biome format --write .",
		"lint:biome": "biome lint .",
		"lint": "eslint ."
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --only=correctness/noUnusedImports --no-errors-on-unmatched",
			"biome format --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@eslint/js": "^10.0.1",
		"concurrently": "^9.1.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.8.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"patch-package": "^8.0.1",
		"typescript-eslint": "^8.66.0"
	}
}
